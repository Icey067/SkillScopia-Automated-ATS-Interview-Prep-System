# Backend
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_URL=postgresql://interview:interview@db:5432/interview_db

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3
LLM_TIMEOUT_SECONDS=60
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=10
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limits (requests per minute)
UPLOAD_RATE_LIMIT=5/minute
CHAT_RATE_LIMIT=20/minute

# dummy = skip Ollama during resume parse (Phase 3); llm = full pipeline
PARSE_MODE=llm

# Local frontend / non-docker backend
# DATABASE_URL=postgresql://interview:interview@localhost:5432/interview_db
# OLLAMA_BASE_URL=http://localhost:11434
# UPLOAD_DIR=./uploads

# Postgres (docker-compose)
POSTGRES_USER=interview
POSTGRES_PASSWORD=interview
POSTGRES_DB=interview_db
POSTGRES_PORT=5432

# Ollama
OLLAMA_PORT=11434
BACKEND_PORT=8000
